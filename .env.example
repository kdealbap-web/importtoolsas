# Plantilla de variables de entorno — Importtools Latam S.A.S
# Copiar a .env y rellenar con valores reales. NUNCA versionar el .env real.
# (Referencia para scripts de despliegue/backup; PrestaShop guarda su config en el servidor.)

# --- Base de datos (cPanel → MySQL Databases) ---
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Hosting / cPanel (LAH plan H2) ---
CPANEL_HOST=
CPANEL_USER=
FTP_HOST=
FTP_USER=
FTP_PASSWORD=

# --- Sitio ---
SITE_URL=https://www.importtoolsas.com
PS_ADMIN_DIR=          # carpeta de back-office (renombrada por seguridad)
