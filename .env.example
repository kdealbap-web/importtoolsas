# ===========================================================================
# Plantilla de variables de entorno — Importtools Latam S.A.S
# ---------------------------------------------------------------------------
# ⚠️ ESTE FICHERO SI SE VERSIONA. No poner valores reales aqui: los secretos van
#    en `.env`, que esta cubierto por `.gitignore` (linea 5).
#
#   cp .env.example .env      # y editar SOLO el .env
#
# ⚠️ Tampoco pegar contraseñas en un chat ni en un correo. Se escriben
#    directamente en el `.env` de este equipo.
#    Procedimiento: deploy/paquete/32-COMO-DARME-EL-FTP.md
#
# QUIEN LEE CADA COSA
#   deploy/subir-a-produccion-ftps.py  ->  FTP_HOST, FTP_PORT, FTP_USER,
#                                          FTP_PASSWORD, FTP_DOCROOT, SITE_URL
#   (el resto son de referencia para respaldos y consultas manuales)
# ===========================================================================

# --- FTPS explicito, para subir ficheros a produccion ----------------------
# En cPanel: «Cuentas FTP». Lo recomendable es una cuenta DEDICADA con directorio
# raiz `public_html` en vez de la del cPanel principal, para que lo que se pueda
# tocar quede acotado al sitio. Ver el documento 32.
FTP_HOST=ftp.importtoolsas.com
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=

# Carpeta que es la raiz del sitio, RELATIVA al directorio donde entra el FTP.
#   · cuenta de cPanel principal           -> public_html
#   · cuenta FTP dedicada anclada al sitio -> .   (ya entra dentro)
# Si se equivoca, el script falla al entrar ANTES de escribir nada y lo dice.
FTP_DOCROOT=public_html

# --- Sitio ----------------------------------------------------------------
# Con `www`: es el dominio canonico, el unico con el que casan las reglas de
# imagen del .htaccess y el AJAX del back office.
SITE_URL=https://www.importtoolsas.com
PS_ADMIN_DIR=            # carpeta del back office (renombrada por seguridad)

# --- Base de datos (cPanel -> MySQL Databases) -----------------------------
# ⚠️ Solo de referencia. El hosting NO permite MySQL remoto, asi que el SQL de
#    las rondas se ejecuta a mano en phpMyAdmin. Estos scripts no la usan.
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Hosting / cPanel (LAH plan H2) ---------------------------------------
CPANEL_HOST=
CPANEL_USER=

# --- SSH (cPanel -> «Acceso SSH» -> «Administrar claves SSH») -------------
# Si la clave se genera EN EL SERVIDOR, la privada se queda alli: para usarla
# desde este equipo hay que descargarla y guardarla FUERA del repo, y apuntar
# aqui su ruta. Nunca meter la clave privada dentro del repositorio.
SSH_USER=
SSH_ID=                  # nombre del par de claves, p.ej. id_rsa_cckey
SSH_KEY_PATH=            # ruta LOCAL a la clave privada, fuera del repo
SSH_PASSWORD=            # solo si el hosting admite autenticacion por clave-contraseña
