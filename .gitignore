# Dependencias
node_modules/

# Variables de entorno y secretos (NUNCA versionar)
.env
.env.local
.env.*.local
*.pem
*.key

# Licencias / activos comerciales del tema (no versionar)
theme-autosoe/*.zip
*.zip
*-license.txt

# Tema padre comercial de ThemeForest (41 MB, licencia de pago). Lo que SÍ se versiona
# es el tema hijo `theme-autosoe/vt_autosoe_child/`, que es lo nuestro.
theme-autosoe/themeforest-*/

# Los .zip de `deploy/paquete/` son ARTEFACTOS: se reconstruyen con
#   python local-dev/empaquetar.py
# desde `theme-autosoe/vt_autosoe_child/`, `modules-custom/itcotizacion/`, `deploy/img/`
# y `deploy/paquete/modules/`. No se versionan (los cubre `*.zip` de arriba).
# Excepción documentada: los dos `traducciones-EXTRAER-EN-*.zip` de
# `deploy/paquete/historico/` NO se reconstruyen — son el catálogo es-CO del núcleo de
# PrestaShop. Ver `deploy/paquete/historico/LEEME.md`.

# Respaldos locales
backups/

# Documentos e imágenes generados (cotizaciones, salidas .docx/.pdf, páginas)
*.docx
*.pdf
page-*.jpg
!docs/**/*.docx
!docs/**/*.pdf

# Logs
*.log
npm-debug.log*

# Temporales / locks de editores de oficina
*.tmp
.~lock.*#

# Entorno local (Docker): datos y clones de producción (grandes / con secretos)
local-dev/prestashop/
local-dev/dump/*
!local-dev/dump/.gitkeep
local-dev/data/

# Dumps de base de datos (datos reales de producción: hashes de empleados,
# clientes, configuración) — NUNCA versionar. Se conservan los CSV de import.
db/*.sql
!db/import/**

# Sistema operativo / editores
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/

# Ficheros de bloqueo de Office (se crean al tener el xlsx abierto)
~$*
# Comprimidos redundantes: los logos ya estan extraidos en docs/brands_logos/Logos/
docs/*.rar

# Credenciales de entrega: lleva la clave temporal del cliente. Se entrega por canal aparte.
deploy/paquete/05-CREDENCIALES.md
# php.ini de produccion: no es secreto, pero es config del servidor, no del proyecto
deploy/paquete/config/php.ini.produccion

# Carpeta de entrada: volcados y logs de produccion (datos reales)
deploy/entrada/*
!deploy/entrada/LEEME.md

# Capturas y recortes de trabajo del espejo: se regeneran con local-dev/captura.sh
tmp-shots/
tmp-rec/
