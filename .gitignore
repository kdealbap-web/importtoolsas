*.pdf
page-*.jpg
!docs/**/*.docx
!docs/**/*.pdf

# Logs
*.log
npm-debug.log*

# Temporales / locks de editores de oficina
*.tmp
.~lock.*#

# Sistema operativo / editores
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
